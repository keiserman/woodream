---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={['btn', className]}>
  <span><slot /></span>
  <span class="flex items-center justify-center"><ArrowIcon /></span>
</a>
