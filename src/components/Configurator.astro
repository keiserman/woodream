---
import { Image } from 'astro:assets';
import BackgroundImage from './BackgroundImage.astro';
import ConfiguratorOption from './ConfiguratorOption.astro';
import ConfiguratorReview from './ConfiguratorReview.astro';
import FormStatus from './FormStatus.astro';
import WoodDetails from './WoodDetails.astro';
import { formEndpoint, formatPrice } from '../data/site';
import { defaultPicks, evaluate } from '../lib/configurator';
import type { Product } from '../lib/products';

/**
 * Product builder: a live preview stacked from transparent layers, the estimated
 * price, and the options in steps, ending with a review and the inquiry form.
 * The logic is in src/lib/configurator.ts and src/scripts/configurator.ts wires it
 * to this markup. Each product's setup is in src/content/ (see docs/product-configurator.md).
 */
interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, config, base, layers, swatches } = product;
const { steps } = config;
const start = evaluate(config, defaultPicks(config));
const hasWoodDetails = steps.some((step) => step.options.some((option) => option.woodDetails));

const stepNames = [...steps.map((step) => step.name), 'Review'];
const reviewStep = steps.length;

// The preview zooms to 2x on hover, so request twice the displayed size. On small
// screens it's a thumbnail that expands to at most the screen's width.
const layerWidths = [800, 1600, 2400];
const layerSizes = '(max-width: 767px) 400px, 1200px';
---

<section class="px-site pt-40 pb-24 max-md:pt-32">
  <div class="mx-auto w-full max-w-(--container-site)" x-data={`configurator(${JSON.stringify(config)})`}>
    <form
      data-contact-form
      data-configurator
      name="product-inquiry"
      method="post"
      action={formEndpoint || undefined}
      class="grid grid-cols-[0.75fr_1fr] gap-16 max-md:grid-cols-1"
    >
      <input type="hidden" name="Product" value={name} />
      <input type="hidden" name="Estimated Price" value={formatPrice(start.total)} :value="formatPrice(view.total)" />
      <input type="hidden" name="Price Breakdown" :value="breakdown" />
      <input type="hidden" name="Design Link" :value="shareUrl" />

      <div
        :data-preview-expanded="expanded || null"
        class="group sticky top-32 flex flex-col gap-4 self-start max-md:fixed max-md:inset-x-0 max-md:top-auto max-md:bottom-0 max-md:z-99 max-md:flex-row max-md:flex-wrap max-md:items-center max-md:gap-3 max-md:border-t max-md:border-section-border max-md:bg-white max-md:p-3"
      >
        <div
          @pointermove="zoom($event)"
          @pointerleave="unzoom()"
          @click="togglePreview()"
          class="overflow-hidden max-md:size-14 max-md:cursor-pointer max-md:group-data-[preview-expanded]:order-last max-md:group-data-[preview-expanded]:mx-auto max-md:group-data-[preview-expanded]:size-auto max-md:group-data-[preview-expanded]:w-full max-md:group-data-[preview-expanded]:max-w-[60dvh]"
        >
          <div x-ref="preview" class="relative aspect-square bg-dark-beige transition-[transform-origin] duration-300 ease-out">
            <BackgroundImage src={base} alt={`${name} preview`} widths={layerWidths} sizes={layerSizes} priority />
            {
              config.layerOrder.map((layer) => (
                <Image
                  src={layers[layer]}
                  alt=""
                  widths={layerWidths}
                  sizes={layerSizes}
                  format="avif"
                  loading="eager"
                  data-layer={layer}
                  x-bind:class="view.layers.includes($el.dataset.layer) ? 'opacity-100' : 'opacity-0'"
                  class="pointer-events-none absolute inset-0 size-full object-cover transition-opacity duration-200"
                />
              ))
            }
          </div>
        </div>
        <div class="flex flex-col gap-1 max-md:flex-1 max-md:gap-0">
          <div
            x-text="formatPrice(view.total)"
            class="text-[5rem] leading-[1.1] max-md:text-[1.75rem]"
          >
            {formatPrice(start.total)}
          </div>
          <div class="text-[18px] text-[#79675b] max-md:text-[14px]">Estimated Price</div>
        </div>
        <button
          type="button"
          @click="togglePreview()"
          :aria-expanded="expanded"
          aria-expanded="false"
          x-text="expanded ? 'Hide preview' : 'View preview'"
          class="btn cursor-pointer normal-case md:hidden"
        >
          View preview
        </button>
      </div>

      <div class="flex min-w-0 flex-col gap-8">
        <div class="flex flex-col gap-2">
          <h1 class="text-[40px] normal-case xl:text-[47px] 2xl:text-[47px] max-md:text-[40px] max-sm:text-[35px]">
            Build your<br />{name.toLowerCase()}
          </h1>
          <p class="mb-2.5">Start customizing and watch it update live.<br />Submit your dream, we’ll make it real.</p>
        </div>

        <nav x-ref="stepper" aria-label="Steps" class="relative flex scroll-mt-32 overflow-x-auto [scrollbar-width:none]">
          {
            stepNames.map((stepName, index) => (
              <button
                type="button"
                @click={`goTo(${index})`}
                aria-current={index === 0 ? 'step' : undefined}
                :aria-current={`step === ${index} ? 'step' : null`}
                class="group/step flex flex-1 cursor-pointer items-center justify-center gap-1.5 border-b-2 border-section-border px-2 pb-3 text-[15px] whitespace-nowrap text-grey uppercase transition-colors duration-200 hover:text-black aria-[current=step]:border-black aria-[current=step]:text-black"
              >
                {stepName}
                {index < reviewStep && (
                  <svg
                    :class={`stepDone(${index}) && 'opacity-100'`}
                    class="size-3 text-accent opacity-0 transition-opacity duration-200"
                    viewBox="0 0 12 12"
                    fill="none"
                    role="img"
                    aria-label="Complete"
                  >
                    <path d="M1.5 6.5 4.5 9.5 10.5 2.5" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                )}
              </button>
            ))
          }
        </nav>

        {
          steps.map((step, index) => (
            <div hidden={index !== 0} :hidden={`step !== ${index}`} class="flex flex-col gap-4">
              <h2 tabindex="-1" class="sr-only" data-step-heading>{step.name}</h2>
              {step.options.map((option) => (
                <ConfiguratorOption
                  option={option}
                  visible={start.visible.includes(option.name)}
                  images={{ base, layers, swatches }}
                />
              ))}
              <div class="flex items-center justify-between gap-5 pt-4">
                {index > 0 ? (
                  <button type="button" @click={`goTo(${index - 1})`} class="btn cursor-pointer">
                    Back
                  </button>
                ) : (
                  <span />
                )}
                <button
                  type="button"
                  @click={`goTo(${index + 1})`}
                  class="cursor-pointer bg-black px-5 py-3 text-white transition-all duration-200 hover:bg-grey"
                >
                  Next: {stepNames[index + 1]}
                </button>
              </div>
            </div>
          ))
        }

        <div hidden :hidden={`step !== ${reviewStep}`} class="flex flex-col gap-8">
          <h2 tabindex="-1" class="sr-only" data-step-heading>Review</h2>
          <ConfiguratorReview backStep={reviewStep - 1} />
        </div>
      </div>
    </form>
    <FormStatus />
  </div>
</section>

{hasWoodDetails && <WoodDetails />}

<script>
  import '../scripts/configurator';
</script>
