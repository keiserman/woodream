---
/** The configurator's last step: an itemized summary of the design and the inquiry form. */
interface Props {
  /** The step the Back button returns to. */
  backStep: number;
}

const { backStep } = Astro.props;
---

<div class="flex flex-col gap-4 bg-[#96815b1a] p-4">
  <div class="flex items-center justify-between gap-4">
    <div class="font-label text-[12px] font-semibold tracking-[0.03em] uppercase">Your design</div>
    <button
      type="button"
      @click="copyLink()"
      x-text="copied ? 'Link copied' : 'Copy link to this design'"
      class="cursor-pointer text-[14px] italic underline"
    >
    </button>
  </div>

  <ul class="flex flex-col text-[18px]">
    <template x-for="line in view.lines" :key="line.option">
      <li class="flex items-baseline justify-between gap-4 border-b border-section-border py-2">
        <button
          type="button"
          @click="goTo(line.step)"
          class="cursor-pointer text-left leading-[1.2] hover:underline"
          :aria-label="'Change ' + line.label"
        >
          <span class="block text-[13px] text-[#79675b]" x-text="line.label"></span>
          <span x-text="line.choice"></span>
        </button>
        <span class="whitespace-nowrap" x-text="line.price ? formatPrice(line.price) : 'Included'"></span>
      </li>
    </template>
  </ul>

  <div class="flex items-baseline justify-between gap-4">
    <span class="text-[18px]">Estimated total</span>
    <span class="text-[30px]" x-text="formatPrice(view.total)"></span>
  </div>

  <div hidden :hidden="!view.missing.length" role="status" class="border-t border-section-border pt-4 text-[16px] leading-[1.3]">
    <p class="mb-2">A few choices are left before you can submit:</p>
    <ul class="flex flex-col gap-1">
      <template x-for="item in view.missing" :key="item.option">
        <li>
          <button type="button" @click="goTo(item.step)" class="cursor-pointer underline" x-text="item.label"></button>
        </li>
      </template>
    </ul>
  </div>
</div>

<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <div class="text-[15px]">Your information</div>
    <div class="flex gap-2">
      <label for="product-first-name" class="sr-only">First name</label>
      <input
        id="product-first-name"
        name="First-Name"
        type="text"
        required
        maxlength="256"
        autocomplete="given-name"
        placeholder="First Name"
        class="field border p-4"
      />
      <label for="product-last-name" class="sr-only">Last name</label>
      <input
        id="product-last-name"
        name="Last-Name"
        type="text"
        required
        maxlength="256"
        autocomplete="family-name"
        placeholder="Last Name"
        class="field border p-4"
      />
    </div>
    <label for="product-phone" class="sr-only">Phone</label>
    <input
      id="product-phone"
      name="Your-Phone"
      type="tel"
      required
      maxlength="256"
      autocomplete="tel"
      placeholder="Your Phone"
      class="field border p-4"
    />
    <label for="product-email" class="sr-only">Email</label>
    <input
      id="product-email"
      name="Your-Email"
      type="email"
      required
      maxlength="256"
      autocomplete="email"
      placeholder="Your Email"
      class="field border p-4"
    />
  </div>

  <p class="mb-2.5 w-full max-w-[55ch] text-[14px]">
    *After submitting this form, someone will reach out within 24 hours to review and confirm your order. Once your
    deposit is received, you can stop by the showroom to choose hardware (if applicable) and finalize your stain color.
  </p>
</div>

<div class="flex items-center justify-between gap-5">
  <button type="button" @click={`goTo(${backStep})`} class="btn cursor-pointer">Back</button>
  <input
    type="submit"
    value="Submit Inquiry"
    data-wait="Please wait..."
    :disabled="view.missing.length > 0"
    class="cursor-pointer bg-black px-5 py-3 leading-[23px] text-white transition-all duration-200 hover:bg-grey disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-black"
  />
</div>
