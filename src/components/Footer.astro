---
import type { ImageMetadata } from 'astro';
import { backgroundUrl } from '../lib/images';
import Reveal from './Reveal.astro';
import readyImage from '../assets/images/footer/ready.avif';
import { contact, emailHref, isCurrentPage, legalLinks, navLinks, phoneHref, site } from '../data/site';

export interface FooterBanner {
  image: ImageMetadata;
  /** Caption HTML (may contain <br />). */
  text: string;
  /** Height at tablet width; the About variant is shorter. */
  tabletHeight?: 350 | 400;
}

interface Props {
  banner?: FooterBanner;
}

const { banner = { image: readyImage, text: 'Ready<br />When you are' } } = Astro.props;
const bannerImage = await backgroundUrl(banner.image, 2400);
const tabletHeight = banner.tabletHeight === 350 ? 'max-lg:min-h-[350px]' : 'max-lg:min-h-[400px]';

const isCurrent = (href: string) => isCurrentPage(Astro.url, href);
const year = new Date().getFullYear();
---

<footer class="relative">
  <Reveal
    dir="down"
    class:list={[
      'flex min-h-[400px] items-center justify-center bg-cover bg-center p-5 text-[45px] leading-none text-white uppercase xl:min-h-[500px] max-lg:text-[35px] max-sm:min-h-[300px] max-sm:text-[30px]',
      tabletHeight,
    ]}
    style={`background-image:url(${bannerImage})`}
  >
    <div class="overflow-hidden">
      <div class="rise text-center" style="--reveal-delay:0.3s" set:html={banner.text} />
    </div>
  </Reveal>

  <section class="relative flex flex-col items-center justify-center px-site pt-[50px] pb-2.5">
    <div class="relative z-1 flex w-full max-w-(--container-site) flex-col items-start gap-5">
      <div class="flex w-full items-stretch justify-between gap-5 max-lg:flex-col max-lg:gap-10">
        <div>
          <a href={phoneHref} class="text-[25px] text-black hover:text-grey">{contact.phone}<br /></a><a
            href={emailHref}
            class="text-[25px] text-black hover:text-grey">{contact.email}</a
          >
        </div>
        <div class="flex gap-7 max-sm:flex-col">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class:list={[
                  'transition-all duration-300 hover:text-black',
                  isCurrent(link.href)
                    ? 'text-black underline decoration-1 underline-offset-4 hover:underline-offset-[9px]'
                    : 'text-grey',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <div
        class="flex w-full items-end justify-between gap-5 pt-[60px] pb-[50px] max-sm:flex-col max-sm:items-start max-sm:pt-0"
      >
        <div class="w-full max-w-[239px] max-md:max-w-[150px]">
          <img src="/images/webclip.png" alt="Woodream" width="256" height="256" loading="lazy" class="w-full" />
        </div>

        <div class="relative z-1 flex w-[32%] flex-col gap-[22px] max-lg:w-2/5 max-md:w-3/5 max-sm:w-full">
          <!-- TODO: point this at a real form handler (Webflow Forms no longer applies). -->
          <form id="footer-form" name="email-form" method="post" class="flex flex-col items-start gap-2.5 text-left">
            <label for="footer-email" class="sr-only">Email</label>
            <input
              id="footer-email"
              name="Email"
              type="email"
              required
              maxlength="256"
              placeholder="Your email."
              class="block h-[38px] min-h-10 w-full leading-[1.42857] border-[0.8px] border-black/40 bg-transparent px-3 py-2 text-[18px] text-black outline-none placeholder:text-[#3d1d074d] focus:border-black"
            />
            <label for="footer-message" class="sr-only">Message</label>
            <textarea
              id="footer-message"
              name="Message"
              maxlength="5000"
              placeholder="How can we help you?"
              class="block h-[170px] min-h-10 w-full leading-[1.42857] border-[0.8px] border-black/40 bg-transparent px-3 py-2 text-[18px] text-black outline-none placeholder:text-[#3d1d074d] focus:border-black"
            ></textarea>
            <input type="submit" value="Contact us" class="btn cursor-pointer" />
          </form>
        </div>
      </div>
    </div>

    <div
      class="relative z-1 flex w-full max-w-(--container-site) items-start justify-between gap-5 max-md:flex-col"
    >
      <div class="flex gap-6 text-[17px] max-sm:flex-col">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="text-black underline decoration-1 underline-offset-4 transition-all duration-300 hover:underline-offset-8"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="text-[18px]">© {year} {site.name}. All rights reserved.</div>
    </div>
  </section>
</footer>
