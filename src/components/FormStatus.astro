---
/**
 * Success and error messages for a contact form. Place right after a
 * <form data-contact-form> inside the same parent; src/scripts/contact-form.ts
 * shows the right one after submitting.
 */
---

<div data-form-done role="status" hidden class="min-h-10 border-[0.8px] border-black/40 p-5 text-center text-[18px]">
  Thank you! Your submission has been received!
</div>
<div data-form-fail role="alert" hidden class="bg-[#ffdede] p-2.5 text-[18px]">
  Oops! Something went wrong while submitting the form.
</div>
