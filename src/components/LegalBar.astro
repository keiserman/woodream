---
import { legalLinks, site } from '../data/site';

const year = new Date().getFullYear();
---

<div class="relative z-1 flex w-full max-w-(--container-site) items-start justify-between gap-5 max-md:flex-col">
  <div class="flex gap-6 text-[17px] max-sm:flex-col">
    {
      legalLinks.map((link) => (
        <a
          href={link.href}
          class="text-black underline decoration-1 underline-offset-4 transition-all duration-300 hover:underline-offset-8"
        >
          {link.label}
        </a>
      ))
    }
  </div>
  <div class="text-[18px]">© {year} {site.name}. All rights reserved.</div>
</div>
