---
import Button from './Button.astro';
import { isCurrentPage, navLinks } from '../data/site';

const isCurrent = (href: string) => isCurrentPage(Astro.url, href);
// On desktop, Contact is the button on the right instead of a menu link.
const mobileOnly = (href: string) => href === '/contact';
---

<header
  id="navbar"
  class="fixed top-0 z-100 flex w-full flex-col items-center justify-center border-b-[0.8px] border-black/30 bg-bg px-site py-10 transition-transform duration-500 ease-out max-lg:py-[30px] max-md:py-5 motion-safe:animate-nav-in"
>
  <div class="flex w-full max-w-[1432px] items-center justify-between">
    <a href="/" aria-label="Woodream home" class="w-1/4 max-md:w-1/2 max-sm:w-3/4">
      <img src="/images/logo.svg" alt="Woodream" class="-mt-3 w-full max-w-44" width="176" height="20" />
    </a>

    <nav
      id="nav-menu"
      aria-label="Main"
      class="flex gap-[50px] max-md:invisible max-md:absolute max-md:inset-x-0 max-md:top-full max-md:mt-px max-md:-translate-y-4 max-md:flex-col max-md:gap-0 max-md:bg-bg max-md:px-5 max-md:pb-5 max-md:opacity-0 max-md:transition-all max-md:duration-500 max-sm:pb-[30px] max-md:[.nav-open_&]:visible max-md:[.nav-open_&]:translate-y-0 max-md:[.nav-open_&]:opacity-100"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'text-[15px] font-medium text-grey uppercase transition-all duration-300 hover:text-black',
              'max-md:block max-md:border-b max-md:border-section-border max-md:py-5 max-md:text-[20px]',
              mobileOnly(link.href) && 'hidden',
              isCurrent(link.href) &&
                'text-black underline underline-offset-2 hover:underline-offset-[5px] max-lg:no-underline',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      id="nav-toggle"
      type="button"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Open menu"
      class="hidden cursor-pointer px-[18px] pt-[2px] text-black max-md:flex max-sm:px-0"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="3" y="5" width="18" height="2"></rect>
        <rect x="3" y="11" width="18" height="2"></rect>
        <rect x="3" y="17" width="18" height="2"></rect>
      </svg>
    </button>

    <div class="flex w-1/4 items-center justify-end max-md:hidden">
      <Button href="/contact">Contact us</Button>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')!;
  const toggle = document.getElementById('nav-toggle')!;

  toggle.addEventListener('click', () => {
    const open = navbar.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  // Hide the bar while scrolling down, bring it back on scroll up.
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      const hide = y > lastY && y > navbar.offsetHeight && !navbar.classList.contains('nav-open');
      navbar.style.transform = hide ? 'translateY(-100%)' : '';
      lastY = y;
    },
    { passive: true },
  );
</script>
