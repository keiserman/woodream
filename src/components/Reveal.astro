---
/**
 * Wraps content in an overflow-hidden box that wipes into view with a
 * clip-path once it scrolls into view (see src/scripts/reveal.ts and the
 * "Reveals" rules in global.css).
 */
interface Props {
  as?: string;
  class?: string;
  /** Direction the wipe travels: "up" shows the bottom edge first. */
  dir?: 'up' | 'down' | 'left';
  delay?: number;
  /** Reveal on page load instead of on scroll. */
  onLoad?: boolean;
  /** Render the clipping box without any animation. */
  disabled?: boolean;
  /** Extra inline styles (e.g. a background image); merged with the delay. */
  style?: string;
  [attr: string]: unknown;
}

const {
  as: Tag = 'div',
  class: className,
  dir = 'up',
  delay = 0,
  onLoad = false,
  disabled = false,
  style,
  ...attrs
} = Astro.props;
const delayStyle = delay ? `--reveal-delay:${delay}s` : '';
const mergedStyle = [delayStyle, style].filter(Boolean).join(';') || undefined;
---

<Tag
  {...attrs}
  class:list={['relative overflow-hidden', className]}
  data-reveal={disabled ? undefined : onLoad ? 'load' : 'scroll'}
  data-dir={disabled ? undefined : dir}
  style={mergedStyle}
>
  <slot />
</Tag>
