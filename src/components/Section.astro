---
import Reveal from './Reveal.astro';

/**
 * Standard content section: a small "tab" label on the left (25%)
 * and a heading + intro row followed by the default slot on the right (75%).
 *
 * Slots:
 *   heading – the <h2> contents
 *   intro   – the paragraph beside the heading
 *   default – everything below the heading row
 */
interface Props {
  tab: string;
  id?: string;
  headingClass?: string;
  /** Width of the intro column; defaults to half the row. */
  introClass?: string;
  /** Space between the heading row and the content below it. */
  gap?: 'default' | 'medium' | 'tight';
  /** Keep the columns at exactly 25% and 75% on tablets too, with no space between them. */
  flush?: boolean;
  beige?: boolean;
  class?: string;
  /** Slide the heading and intro in when they scroll into view. */
  animate?: boolean;
}

const {
  tab,
  id,
  headingClass,
  introClass = 'w-1/2',
  gap = 'default',
  flush = false,
  beige = false,
  class: className,
  animate = true,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'relative flex items-center justify-center px-site py-20',
    beige && 'overflow-hidden bg-dark-beige',
    className,
  ]}
>
  <div
    class:list={[
      'relative z-1 flex w-full max-w-(--container-site) flex-row items-start justify-between max-md:flex-col',
      flush ? 'max-md:gap-5' : 'gap-5',
    ]}
  >
    <div class:list={['w-1/4 border-t border-section-border pt-5 max-md:w-full', !flush && 'max-lg:w-1/5']}>
      <div class="flex max-w-[135px] items-start justify-start gap-2.5 text-[20px] max-md:max-w-none">
        <div class="mt-[5px] min-h-2.5 min-w-2.5 rounded-full bg-black"></div>
        <div>{tab}</div>
      </div>
    </div>

    <div
      class:list={[
        'flex w-3/4 flex-col items-start justify-start border-t border-section-border pt-5 max-md:w-full',
        !flush && 'max-lg:w-4/5',
        {
          default: 'gap-[100px] max-lg:gap-y-[75px] max-md:gap-[50px]',
          medium: 'gap-16',
          tight: 'gap-[30px]',
        }[gap],
      ]}
    >
      <div class="flex w-full items-stretch justify-between gap-5 max-md:flex-col">
        <Reveal disabled={!animate} class="pb-2.5">
          <h2 class:list={[headingClass]}><slot name="heading" /></h2>
        </Reveal>
        <Reveal
          disabled={!animate}
          delay={0.15}
          class:list={['flex items-start justify-end pb-2.5 max-md:w-full max-md:justify-start', introClass]}
        >
          <div class="2xl:w-auto 2xl:max-w-[550px]"><slot name="intro" /></div>
        </Reveal>
      </div>

      <slot />
    </div>
  </div>
</section>
