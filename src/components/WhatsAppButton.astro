---
import { whatsappHref } from '../data/site';
---

<div
  class="group fixed right-5 bottom-5 z-1000 flex flex-col items-end justify-end gap-2.5 max-md:right-auto max-md:left-site max-md:items-start max-md:gap-[5px]"
>
  <div class="relative right-9 h-[31px] w-[131px] overflow-hidden text-center text-[13px] leading-[23px] max-md:right-[18px]">
    <div class="relative z-1 overflow-hidden">
      <div class="translate-y-[120%] transition-transform duration-500 ease-out group-hover:translate-y-0">
        Send us a message!
      </div>
    </div>
    <div
      class="absolute inset-0 translate-y-full bg-[url(/images/chat-bubble.svg)] opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100 max-md:-scale-x-100"
    >
    </div>
  </div>
  <a
    href={whatsappHref}
    aria-label="Message us on WhatsApp"
    class="relative flex size-[90px] items-center justify-center overflow-hidden rounded-full bg-accent max-md:size-[60px]"
  >
    <img
      src="/images/wa-icon.png"
      alt=""
      width="49"
      height="46"
      class="absolute -translate-x-[74px] transition-transform duration-500 ease-out group-hover:translate-x-0 max-md:max-w-10"
    />
    <img
      src="/images/wa-icon.png"
      alt=""
      width="49"
      height="46"
      class="transition-transform duration-500 ease-out group-hover:translate-x-[75px] max-md:max-w-10"
    />
  </a>
</div>
