---
import { getCollection } from 'astro:content';
import WoodRow from './WoodRow.astro';

/** Dialog comparing the wood types in tabs. Any button with `data-wood-details-open` opens it. */
const woods = (await getCollection('woods')).sort((a, b) => a.data.order - b.data.order);
---

<dialog
  id="wood-details"
  aria-label="Compare wood types"
  class="m-auto w-full max-w-160 overflow-visible bg-transparent text-black opacity-0 transition-[opacity,display,overlay] duration-500 transition-discrete backdrop:bg-black/80 backdrop:opacity-0 backdrop:backdrop-blur-[5px] backdrop:transition-[opacity,display,overlay] backdrop:duration-500 backdrop:transition-discrete open:opacity-100 open:backdrop:opacity-100 starting:open:opacity-0 starting:open:backdrop:opacity-0"
>
  <div class="max-h-[90dvh] overflow-y-auto rounded-2xl bg-white">
    <div role="tablist" class="flex">
      {
        woods.map(({ id, data }, index) => (
          <button
            type="button"
            role="tab"
            id={`wood-tab-${id}`}
            aria-controls={`wood-panel-${id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            class="flex-1 cursor-pointer bg-dark-beige py-3 pr-4 pl-6 text-center text-[24px] aria-selected:bg-accent aria-selected:text-bg"
          >
            {data.shortName ?? data.name}
          </button>
        ))
      }
    </div>
    {
      woods.map(({ id, data }, index) => (
        <div role="tabpanel" id={`wood-panel-${id}`} aria-labelledby={`wood-tab-${id}`} hidden={index !== 0}>
          <WoodRow wood={data} />
        </div>
      ))
    }
  </div>
  <button
    type="button"
    data-wood-details-close
    aria-label="Close"
    class="fixed top-4 right-4 cursor-pointer rounded-full bg-white p-2"
  >
    <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12z"
      ></path>
    </svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#wood-details')!;
  const tabs = dialog.querySelectorAll<HTMLButtonElement>('[role="tab"]');

  document.querySelectorAll('[data-wood-details-open]').forEach((button) => {
    button.addEventListener('click', () => dialog.showModal());
  });

  dialog.querySelector('[data-wood-details-close]')!.addEventListener('click', () => dialog.close());

  // Clicks on the backdrop land on the dialog itself.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        document.getElementById(other.getAttribute('aria-controls')!)!.hidden = !selected;
      }
    });
  }
</script>
