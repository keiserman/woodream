---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Reveal from "@/components/wrapper/Reveal.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** First line of the page title. */
  line1: string;
  /** Second line, indented under the first. */
  line2?: string;
  /** Title size. `compact` is the smaller title used on Gallery and Contact. */
  size?: "large" | "compact";
}

const {
  render = true,
  line1,
  line2,
  size = "large",
  class: className,
  ...rest
} = Astro.props;

const intro = await slotContent(Astro.slots);
const action = await slotContent(Astro.slots, "action");
---

{render && line1 && (
  <div
    class:list={["hero-main_wrap", size !== "large" && size, className]}
    {...rest}
  >
    <div class="hero-main_title">
      <Reveal onLoad delay={0.2}>
        <Heading tag="h1">
          {line1}
          {line2 && (
            <Fragment>
              <br />
              <span class="hero-main_indent">{line2}</span>
            </Fragment>
          )}
        </Heading>
      </Reveal>
    </div>
    {(intro || action) && (
      <div class="hero-main_intro">
        <Reveal onLoad delay={0.45}>
          <div class="hero-main_text">
            <Paragraph variant="small">
              <Fragment set:html={intro} />
            </Paragraph>
            <Fragment set:html={action} />
          </div>
        </Reveal>
      </div>
    )}
  </div>
)}

<style is:global>
  @layer components {
    .hero-main_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--site-gutter);
      padding-bottom: var(--space-5);
      & > * {
        padding-bottom: 0.625rem;
      }
      @media (width >= 64rem) {
        flex-direction: row;
        align-items: end;
        justify-content: space-between;
      }
      &.compact {
        --h1: clamp(2.5rem, 1.786rem + 3.571vw, 5rem);
      }
    }

    .hero-main_indent {
      @media (width >= 30rem) {
        padding-left: 1.2em;
      }
    }

    .hero-main_text {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--site-gutter);
    }

    .hero-main_intro {
      @media (width >= 48rem) {
        width: 77%;
      }
      @media (width >= 64rem) {
        width: 41%;
        flex: none;
      }
      @media (width >= 80rem) {
        width: 35%;
      }
    }
  }
</style>
