---
import type { HTMLAttributes } from "astro/types";
import Img from "@/components/media/Img.astro";
import Reveal from "@/components/wrapper/Reveal.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Left photo. */
  first: ImageMetadata;
  /** Left photo alt text. */
  firstAlt?: string;
  /** Right photo. */
  second: ImageMetadata;
  /** Right photo alt text. */
  secondAlt?: string;
  /**
   * Layout. `offset`: a wide photo with the caption under it and a smaller
   * one raised beside it. `split`: two photos side by side, 45% and 55%.
   */
  variant?: "offset" | "split";
}

const {
  render = true,
  first,
  firstAlt,
  second,
  secondAlt,
  variant = "offset",
  class: className,
  ...rest
} = Astro.props;

const caption = await slotContent(Astro.slots);
---

{render && first && second && (
  <div class:list={["photo-pair_wrap", variant, className]} {...rest}>
    <div class="photo-pair_col">
      <Reveal>
        <Img
          src={first}
          alt={firstAlt}
          variant="constrained"
          sizes="(max-width: 479px) 100vw, 50vw"
        />
      </Reveal>
      {caption && (
        <Reveal>
          <p>
            <Fragment set:html={caption} />
          </p>
        </Reveal>
      )}
    </div>
    <div class="photo-pair_col">
      <Reveal delay={0.15}>
        <Img
          src={second}
          alt={secondAlt}
          variant="constrained"
          sizes="(max-width: 479px) 100vw, 45vw"
        />
      </Reveal>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .photo-pair_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--site-gutter);
      @media (width >= 30rem) {
        flex-direction: row;
      }

      &.offset {
        align-items: end;
        margin-top: var(--space-6);
      }
    }

    .photo-pair_col {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);

      .offset > & {
        @media (width >= 30rem) {
          width: 60%;
          & + & {
            width: 40%;
            align-items: center;
            padding-bottom: 7.8125rem;
          }
        }
      }
      .split > & {
        @media (width >= 30rem) {
          width: 45%;
          & + & {
            width: 55%;
          }
        }
      }
    }
  }
</style>
