---
import { getCollection } from "astro:content";
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/logo/logo.svg";
import arrow from "@/assets/icons/arrow.svg";
import { NAV_CTA, NAV_LINKS, SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const products = (await getCollection("products"))
  .map(({ id, data }) => ({ href: `/cabinets/${id}`, label: data.name }))
  .sort((a, b) => a.label.localeCompare(b.label, undefined, { numeric: true }));
const submenus = { products };
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href="/" aria-label={SITE_NAME}>
        <Icon src={logo} variant="full-width" />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main">
        <div class="nav_menu_inner">
          <ul class="nav_links">
            {NAV_LINKS.map((link) => {
              const children = link.submenu ? submenus[link.submenu] : [];
              if (children.length === 0) {
                return (
                  <NavLink
                    href={link.href}
                    class={link.href === NAV_CTA.href ? "is-cta" : undefined}
                  >
                    {link.label}
                  </NavLink>
                );
              }
              const id = `nav-sub-${link.href.replace(/\W+/g, "") || "home"}`;
              return (
                <li class="nav_group">
                  <div class="nav_group_head">
                    <a
                      class="nav_link"
                      href={link.href}
                      aria-current={link.href === path ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                    <button
                      class="nav_sub_toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls={id}
                      aria-label={`${link.label} pages`}
                    >
                      <span class="nav_sub_icon">
                        <Icon src={arrow} variant="small" />
                      </span>
                    </button>
                  </div>
                  <div class="nav_sub" id={id}>
                    <ul class="nav_sub_list">
                      {children.map((child) => (
                        <li>
                          <a
                            class="nav_sub_link"
                            href={child.href}
                            aria-current={
                              child.href === path ? "page" : undefined
                            }
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </nav>
      <div class="nav_cta">
        <Button element="link" variant="link" href={NAV_CTA.href}>
          {NAV_CTA.label}
        </Button>
      </div>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    /* Submenus: the arrow beside a link opens its list. From 48rem the list
       also opens on hover or keyboard focus, in CSS. */
    const groups = [...nav.querySelectorAll<HTMLElement>(".nav_group")];
    const setGroup = (group: HTMLElement, open: boolean) => {
      group.classList.toggle("is-open", open);
      group
        .querySelector(".nav_sub_toggle")
        ?.setAttribute("aria-expanded", String(open));
    };
    const closeGroups = () => groups.forEach((group) => setGroup(group, false));

    for (const group of groups) {
      group.querySelector(".nav_sub_toggle")?.addEventListener("click", () => {
        const open = !group.classList.contains("is-open");
        groups.forEach((other) => setGroup(other, other === group && open));
      });
    }

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const group = groups.find(
        (candidate) =>
          candidate.classList.contains("is-open") ||
          candidate.contains(document.activeElement),
      );
      if (group) {
        closeGroups();
        group.querySelector<HTMLElement>(".nav_sub_toggle")?.focus();
        if (matchMedia("(width >= 48rem)").matches) {
          (document.activeElement as HTMLElement | null)?.blur();
        }
        return;
      }
      if (nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!groups.some((group) => group.contains(target))) closeGroups();
      if (!nav.classList.contains("open")) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
        closeGroups();
      });

    let lastY = scrollY;
    addEventListener(
      "scroll",
      () => {
        const y = scrollY;
        const hide =
          y > lastY &&
          y > nav.offsetHeight &&
          !nav.classList.contains("open") &&
          !nav.contains(document.activeElement);
        nav.classList.toggle("is-hidden", hide);
        lastY = y;
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);
      transition: transform calc(var(--open-duration) * 2.5) ease-out;
      animation: nav-in 1s cubic-bezier(0.65, 0, 0.35, 1) 0.4s backwards;

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
      &.is-hidden {
        transform: translateY(-100%);
      }
    }

    @keyframes nav-in {
      from {
        translate: 0 -100%;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--site-gutter);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 11rem;
      max-width: 75%;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: 0 var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      text-transform: uppercase;
      & > li {
        border-bottom: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-4);
      color: var(--text-2);
      text-decoration: none;
      text-underline-offset: 0.125rem;
      text-decoration-thickness: var(--border-width);
      transition:
        color var(--hover-duration) var(--hover-ease),
        text-underline-offset var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    /* Submenu: collapsed under its link in the small-screen menu */
    .nav_group_head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.375rem;
    }

    .nav_sub_toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-right: -0.75rem;
      color: var(--text-2);
      cursor: pointer;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .nav_sub_icon {
      display: flex;
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
      .nav_group.is-open & {
        rotate: -90deg;
      }
    }

    .nav_sub {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
      .nav_group.is-open > & {
        grid-template-rows: 1fr;
        visibility: visible;
      }
    }

    .nav_sub_list {
      min-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding-left: var(--space-4);
      font-size: var(--text-small);
      text-transform: none;
      & > li:last-child {
        padding-bottom: var(--space-4);
      }
    }

    .nav_sub_link {
      display: block;
      padding-block: var(--space-2);
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .nav_cta {
      display: none;
    }

    @media (width >= 48rem) {
      .nav_inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
      }

      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: 3.125rem;
        font-size: var(--text-label);
        & > li {
          border-bottom: 0;
        }
        & > li:has(> .is-cta) {
          display: none;
        }
      }

      .nav_link {
        padding-block: 0;
      }

      /* Submenu: a panel under the bar, opened on hover, focus or the arrow */
      .nav_group {
        position: relative;
      }

      .nav_group_head {
        justify-content: start;
        gap: 0;
      }

      .nav_sub_toggle {
        min-width: 1.5rem;
        min-height: 1.5rem;
        margin-right: -0.5rem;
      }

      .nav_sub {
        position: absolute;
        top: 100%;
        left: 50%;
        display: block;
        padding-top: calc((var(--nav-height) - 1.5rem) / 2);
        opacity: 0;
        translate: -50% -0.5rem;
        transition:
          opacity var(--open-duration) var(--open-ease),
          translate var(--open-duration) var(--open-ease),
          visibility var(--open-duration) var(--open-ease);
      }

      .nav_group:is(.is-open, :focus-within) > .nav_sub {
        visibility: visible;
        opacity: 1;
        translate: -50% 0;
      }
      @media (hover: hover) {
        .nav_group:hover > .nav_sub {
          visibility: visible;
          opacity: 1;
          translate: -50% 0;
        }
        .nav_group:hover .nav_sub_icon {
          rotate: -90deg;
        }
      }
      .nav_group:focus-within .nav_sub_icon {
        rotate: -90deg;
      }

      .nav_sub_list {
        min-width: 13rem;
        overflow: visible;
        padding: var(--space-3) var(--space-5);
        font-size: var(--text-label);
        text-transform: uppercase;
        white-space: nowrap;
        background-color: var(--background);
        border: var(--border-width) solid var(--border);
        & > li:last-child {
          padding-bottom: 0;
        }
      }

      .nav_cta {
        display: flex;
        justify-content: end;
      }
    }

    @media (width >= 64rem) {
      .nav_link[aria-current="page"] {
        text-decoration: underline;
        @media (hover: hover) {
          &:hover {
            text-underline-offset: 0.3125rem;
          }
        }
      }
    }
  }
</style>
