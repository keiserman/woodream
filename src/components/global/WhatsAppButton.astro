---
import { CONTACT } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{render && (
  <div class="whatsapp_wrap">
    <div class="whatsapp_bubble" aria-hidden="true">
      <span class="whatsapp_bubble-text">Send us a message!</span>
    </div>
    <a
      class="whatsapp_button"
      href={CONTACT.whatsappHref}
      aria-label="Message us on WhatsApp"
    >
      <img
        class="whatsapp_icon is-incoming"
        src="/images/wa-icon.png"
        alt=""
        width="49"
        height="46"
      />
      <img
        class="whatsapp_icon"
        src="/images/wa-icon.png"
        alt=""
        width="49"
        height="46"
      />
    </a>
  </div>
)}

<style is:global>
  @layer components {
    /* On small screens, room under the footer so its last lines scroll clear
       of the button, and scroll padding so focused fields do too. A bottom
       bar (the configurator's price bar) sets --bottom-bar on the root; the
       button sits above it. */
    @media (width < 48rem) {
      :root:has(.whatsapp_wrap) {
        scroll-padding-bottom: calc(var(--bottom-bar, 0rem) + 6rem);
        & body {
          padding-bottom: calc(var(--bottom-bar, 0rem) + 5.75rem);
        }
      }
    }

    .whatsapp_wrap {
      --_ease: 500ms ease-out;
      position: fixed;
      left: var(--site-margin);
      bottom: calc(var(--bottom-bar, 0rem) + 1.25rem);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 0.3125rem;
      @media (width >= 48rem) {
        left: auto;
        right: 1.25rem;
        bottom: 1.25rem;
        align-items: end;
        gap: 0.625rem;
      }
    }

    .whatsapp_bubble {
      position: relative;
      right: 1.125rem;
      width: 8.1875rem;
      height: 1.9375rem;
      overflow: hidden;
      font-size: 0.8125rem;
      line-height: 1.4375rem;
      text-align: center;
      @media (width >= 48rem) {
        right: 2.25rem;
      }
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url(/images/chat-bubble.svg);
        opacity: 0;
        transform: translateY(100%) scaleX(-1);
        transition:
          transform var(--_ease),
          opacity var(--_ease);
        @media (width >= 48rem) {
          transform: translateY(100%);
        }
      }
    }

    .whatsapp_bubble-text {
      position: relative;
      z-index: 1;
      display: block;
      transform: translateY(120%);
      transition: transform var(--_ease);
    }

    .whatsapp_button {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3.75rem;
      height: 3.75rem;
      overflow: hidden;
      border-radius: var(--radius-round);
      background-color: var(--brand-500);
      @media (width >= 48rem) {
        width: 5.625rem;
        height: 5.625rem;
      }
    }

    .whatsapp_icon {
      width: auto;
      max-width: 2.5rem;
      background: none;
      transition: transform var(--_ease);
      @media (width >= 48rem) {
        max-width: none;
      }
      &.is-incoming {
        position: absolute;
        transform: translateX(-4.625rem);
      }
    }

    .whatsapp_wrap:hover {
      & .whatsapp_bubble::before {
        opacity: 1;
        transform: scaleX(-1);
        @media (width >= 48rem) {
          transform: none;
        }
      }
      & .whatsapp_bubble-text {
        transform: none;
      }
      & .whatsapp_icon {
        transform: translateX(4.6875rem);
      }
      & .whatsapp_icon.is-incoming {
        transform: none;
      }
    }
  }
</style>
