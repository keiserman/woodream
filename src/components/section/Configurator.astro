---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Form from "@/components/form/Form.astro";
import ConfiguratorOption from "@/components/content/ConfiguratorOption.astro";
import ConfiguratorReview from "@/components/content/ConfiguratorReview.astro";
import WoodCompare from "@/components/content/WoodCompare.astro";
import { formatPrice } from "@/utils/format.ts";
import { defaultPicks, evaluate } from "@/lib/configurator.ts";
import type { Product } from "@/lib/products.ts";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> & {
  /** The product to build, with its option set and pictures. */
  product: Product;
};

const {
  render = true,
  theme,
  paddingTop = "none",
  paddingBottom,
  product,
} = Astro.props;

const { name, config, base, layers, swatches } = product;
const { steps } = config;
const start = evaluate(config, defaultPicks(config));
const hasWoodDetails = steps.some((step) =>
  step.options.some((option) => option.woodDetails),
);

const stepNames = [...steps.map((step) => step.name), "Review"];
const reviewStep = steps.length;

/* The preview zooms to 2x on hover, so it asks for twice the displayed size. */
const layerSizes = "(max-width: 767px) 400px, 1200px";
---

<Section
  render={render && Boolean(product)}
  theme={theme}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
>
  <div
    class="configurator_wrap"
    x-data={`configurator(${JSON.stringify(config)})`}
  >
    <Form
      name="product-inquiry"
      netlify
      successMessage="Thank you! Your design was sent. We’ll reach out within 24 hours."
      errorMessage="Oops! Something went wrong while submitting the form."
    >
      <div class="configurator_form">
        <input type="hidden" name="Product" value={name} />
        <input
          type="hidden"
          name="Estimated Price"
          value={formatPrice(start.total)}
          :value="formatPrice(view.total)"
        />
        <input type="hidden" name="Price Breakdown" :value="breakdown" />
        <input type="hidden" name="Design Link" :value="shareUrl" />

        {/* Preview and price */}
        <div class="configurator_aside" :data-expanded="expanded || null">
          <div
            class="configurator_frame"
            @pointermove="zoom($event)"
            @pointerleave="unzoom()"
            @click="togglePreview()"
          >
            <div
              class="configurator_preview"
              x-ref="preview"
              role={base ? undefined : "img"}
              aria-label={base ? undefined : `${name} preview`}
            >
              {base && (
                <Img
                  class="cover-absolute"
                  src={base}
                  alt={`${name} preview`}
                  variant="constrained"
                  sizes={layerSizes}
                  loading="eager"
                  fetchPriority="high"
                  transparent
                />
              )}
              {config.layerOrder.map((layer) => (
                <span
                  class="configurator_layer"
                  data-layer={layer}
                  :class="view.layers.includes($el.dataset.layer) && 'is-shown'"
                >
                  <Img
                    class="cover-absolute"
                    src={layers[layer]}
                    variant="constrained"
                    sizes={layerSizes}
                    loading="eager"
                    transparent
                  />
                </span>
              ))}
            </div>
          </div>
          <div class="configurator_price">
            <span class="configurator_amount" x-text="formatPrice(view.total)">
              {formatPrice(start.total)}
            </span>
            <span class="configurator_caption">Estimated Price</span>
          </div>
          <button
            class="configurator_toggle"
            type="button"
            aria-expanded="false"
            :aria-expanded="expanded"
            @click="togglePreview()"
            x-text="expanded ? 'Hide preview' : 'View preview'"
          >
            View preview
          </button>
        </div>

        {/* Steps */}
        <div class="configurator_main">
          <div class="configurator_intro">
            <Heading tag="h1" variant="h2" class="text-transform-none">
              Build your
              <br />
              {name.toLowerCase()}
            </Heading>
            <Paragraph>
              Start customizing and watch it update live.
              <br />
              Submit your dream, we’ll make it real.
            </Paragraph>
          </div>

          <nav class="configurator_steps" x-ref="stepper" aria-label="Steps">
            {stepNames.map((stepName, index) => (
              <button
                class="configurator_step"
                type="button"
                @click={`goTo(${index})`}
                aria-current={index === 0 ? "step" : undefined}
                :aria-current={`step === ${index} ? 'step' : null`}
              >
                {stepName}
                {index < reviewStep && (
                  <svg
                    class="configurator_check"
                    :class={`stepDone(${index}) && 'is-done'`}
                    viewBox="0 0 12 12"
                    fill="none"
                    role="img"
                    aria-label="Complete"
                  >
                    <path
                      d="M1.5 6.5 4.5 9.5 10.5 2.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                )}
              </button>
            ))}
          </nav>

          {steps.map((step, index) => (
            <div
              class="configurator_panel"
              hidden={index !== 0}
              :hidden={`step !== ${index}`}
            >
              <h2 class="sr-only" tabindex="-1" data-step-heading>
                {step.name}
              </h2>
              {step.options.map((option) => (
                <ConfiguratorOption
                  option={option}
                  visible={start.visible.includes(option.name)}
                  images={{ base, layers, swatches }}
                />
              ))}
              <div class="configurator_nav">
                {index > 0 ? (
                  <Button
                    variant="link"
                    arrow={false}
                    x-on:click={`goTo(${index - 1})`}
                  >
                    Back
                  </Button>
                ) : (
                  <span />
                )}
                <Button x-on:click={`goTo(${index + 1})`}>
                  Next: {stepNames[index + 1]}
                </Button>
              </div>
            </div>
          ))}

          <div
            class="configurator_panel"
            hidden
            :hidden={`step !== ${reviewStep}`}
          >
            <h2 class="sr-only" tabindex="-1" data-step-heading>
              Review
            </h2>
            <ConfiguratorReview backStep={reviewStep - 1} />
          </div>
        </div>
      </div>
    </Form>
  </div>
</Section>

<WoodCompare render={render && hasWoodDetails} />

<script>
  import Alpine from "alpinejs";
  import { formatPrice } from "@/utils/format.ts";
  import {
    evaluate,
    picksFromParams,
    picksToParams,
    type ProductConfig,
  } from "@/lib/configurator.ts";

  const isSmallScreen = () => matchMedia("(width < 48rem)").matches;

  /* Choices that get hidden sit in a disabled fieldset, so they aren't
     submitted, but are remembered if the option comes back. */
  Alpine.data("configurator", (config: ProductConfig) => {
    const picks = picksFromParams(config, new URLSearchParams(location.search));
    return {
      picks,
      view: evaluate(config, picks),
      /* A shared link opens on the review. */
      step: location.hash === "#review" ? config.steps.length : 0,
      expanded: false,
      copied: false,
      formatPrice,

      get shareUrl() {
        const query = picksToParams(config, this.picks).toString();
        return `${location.origin}${location.pathname}${query && `?${query}`}#review`;
      },

      get breakdown() {
        return this.view.lines
          .map(
            (line) =>
              `${line.label}: ${line.choice} (${formatPrice(line.price)})`,
          )
          .join("\n");
      },

      isVisible(option: string) {
        return this.view.visible.includes(option);
      },

      isChecked(radio: HTMLInputElement) {
        const lock = this.view.locks[radio.name];
        return (lock ?? this.picks[radio.name]) === radio.value;
      },

      isLocked(radio: HTMLInputElement) {
        const lock = this.view.locks[radio.name];
        return lock !== undefined && lock !== radio.value;
      },

      messageFor(option: string) {
        return this.view.messages[option]?.join(" ") ?? "";
      },

      stepDone(step: number) {
        return !this.view.missing.some((item) => item.step === step);
      },

      choose(input: HTMLInputElement) {
        this.picks = { ...this.picks, [input.name]: input.value };
        this.view = evaluate(config, this.picks);
        const query = picksToParams(config, this.picks).toString();
        history.replaceState(
          null,
          "",
          `${location.pathname}${query && `?${query}`}`,
        );
        this.copied = false;
      },

      goTo(step: number) {
        this.step = step;
        this.expanded = false;
        this.$nextTick(() => {
          const headings = this.$root.querySelectorAll<HTMLElement>(
            "[data-step-heading]",
          );
          headings[step]?.focus({ preventScroll: true });
          const stepper = this.$refs.stepper;
          if (stepper.getBoundingClientRect().top < 100)
            stepper.scrollIntoView();
          /* The steps can overflow on small screens; keep the current one in view. */
          const current = stepper.querySelector<HTMLElement>(
            '[aria-current="step"]',
          );
          if (current)
            stepper.scrollTo({
              left: current.offsetLeft - 20,
              behavior: "smooth",
            });
        });
      },

      async copyLink() {
        await navigator.clipboard.writeText(this.shareUrl);
        this.copied = true;
      },

      togglePreview() {
        if (isSmallScreen()) this.expanded = !this.expanded;
      },

      /* Hovering with a mouse zooms the preview to 2x, following the pointer. */
      zoom(event: PointerEvent) {
        if (event.pointerType !== "mouse" || isSmallScreen()) return;
        const box = (
          event.currentTarget as HTMLElement
        ).getBoundingClientRect();
        const x = ((event.clientX - box.left) / box.width) * 100;
        const y = ((event.clientY - box.top) / box.height) * 100;
        this.$refs.preview.style.transformOrigin = `${x}% ${y}%`;
        this.$refs.preview.style.transform = "scale(2)";
      },

      unzoom() {
        this.$refs.preview.style.transform = "";
      },
    };
  });

  Alpine.start();
</script>

<style is:global>
  @layer components {
    .configurator_wrap {
      width: 100%;
      padding-top: calc(var(--nav-height) + var(--space-8));
    }

    .configurator_form {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 4rem;
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
      }
    }

    /* Preview and price: a sticky column, or a bar along the bottom of small screens */
    .configurator_aside {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 99;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem;
      border-top: var(--border-width) solid var(--border);
      background-color: var(--light-100);
      @media (width >= 48rem) {
        position: sticky;
        top: calc(var(--nav-height) + var(--space-5));
        align-self: start;
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 1rem;
        padding: 0;
        border-top: 0;
        background-color: transparent;
      }
    }

    .configurator_frame {
      width: 3.5rem;
      overflow: hidden;
      cursor: pointer;
      .configurator_aside[data-expanded] & {
        order: 1;
        width: 100%;
        max-width: 60dvh;
        margin-inline: auto;
      }
      @media (width >= 48rem) {
        width: auto;
        cursor: auto;
      }
    }

    .configurator_preview {
      position: relative;
      aspect-ratio: 1;
      background-color: var(--light-200);
      transition: transform-origin 300ms ease-out;
    }

    .configurator_layer {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      &.is-shown {
        opacity: 1;
      }
    }

    .configurator_price {
      display: flex;
      flex: 1;
      flex-direction: column;
      @media (width >= 48rem) {
        gap: 0.25rem;
      }
    }

    .configurator_amount {
      font-size: 1.75rem;
      line-height: 1.1;
      @media (width >= 48rem) {
        font-size: clamp(3rem, 0.8rem + 4.6vw, 5rem);
      }
    }

    .configurator_caption {
      color: color-mix(in lab, var(--brand-500) 80%, var(--text));
      font-size: 0.875rem;
      @media (width >= 48rem) {
        font-size: var(--text-small);
      }
    }

    .configurator_toggle {
      padding-bottom: 0.3em;
      border-bottom: var(--border-width) solid currentcolor;
      font-size: var(--text-label);
      line-height: 1;
      @media (width >= 48rem) {
        display: none;
      }
    }

    /* Steps */
    .configurator_main {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      min-width: 0;
    }

    .configurator_intro {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .configurator_steps {
      display: flex;
      overflow-x: auto;
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
      scrollbar-width: none;
    }

    .configurator_step {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      padding: 0 0.5rem 0.75rem;
      border-bottom: 0.125rem solid var(--border);
      color: var(--text-2);
      font-size: var(--text-label);
      text-transform: uppercase;
      white-space: nowrap;
      transition:
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      &[aria-current="step"] {
        border-color: var(--text);
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .configurator_check {
      width: 0.75rem;
      height: 0.75rem;
      color: var(--brand-500);
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
      &.is-done {
        opacity: 1;
      }
    }

    .configurator_panel {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      &[hidden] {
        display: none;
      }
    }

    .configurator_nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--site-gutter);
      padding-top: 1rem;
    }

    /* Room for the price bar along the bottom of small screens */
    @media (width < 48rem) {
      body:has(.configurator_wrap) {
        padding-bottom: 5.5rem;
        & .whatsapp_wrap {
          bottom: 6.5rem;
        }
      }
      body:has(.configurator_aside[data-expanded]) .whatsapp_wrap {
        display: none;
      }
    }
  }
</style>
