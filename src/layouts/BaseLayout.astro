---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer, { type FooterBanner } from "@/components/global/Footer.astro";
import WhatsAppButton from "@/components/global/WhatsAppButton.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
  /** Footer layout. `minimal` drops the banner, contact block and WhatsApp button. */
  footer?: "full" | "minimal";
  /** Photo banner above the footer. */
  footerBanner?: FooterBanner;
};

const {
  theme = "inherit",
  overlap = true,
  footer = "full",
  footerBanner,
  ...seo
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer variant={footer} banner={footerBanner} />
    <WhatsAppButton render={footer === "full"} />
  </body>
</html>
