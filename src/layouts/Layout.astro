---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LegalBar from '../components/LegalBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import type { FooterBanner } from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  footerBanner?: FooterBanner;
  /** "minimal" shows only the legal links, with no photo banner, contact block or WhatsApp button. */
  footer?: 'full' | 'minimal';
}

const { title = site.title, description = site.description, footerBanner, footer = 'full' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/images/webclip.png" />
    <link rel="preload" href="/fonts/PPMori-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PPNeueMontreal-Book.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Flag JS before first paint so reveals only hide content when the script can show it again. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    {
      footer === 'full' ? (
        <>
          <Footer banner={footerBanner} />
          <WhatsAppButton />
        </>
      ) : (
        <footer class="relative flex flex-col items-center justify-center px-site pt-[50px] pb-2.5">
          <LegalBar />
        </footer>
      )
    }

    <script>
      import '../scripts/reveal';
      import '../scripts/cursor';
      import '../scripts/slider';
      import '../scripts/carousel';
      import '../scripts/countup';
      import '../scripts/contact-form';
    </script>
  </body>
</html>
