---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import RichText from "@/components/typography/RichText.astro";

/** Layout for the Markdown pages in `src/pages/legal/`. */
interface Props {
  frontmatter: { title: string; description?: string };
}

const { title, description } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <Section paddingTop="navoverlap" gap="5">
    <HeroMain line1={title} size="compact" />
    <RichText maxWidth={72}>
      <slot />
    </RichText>
  </Section>
</BaseLayout>
