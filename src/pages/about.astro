---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Button from "@/components/Button.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import BannerPhoto from "@/components/content/BannerPhoto.astro";
import LayoutLabeled from "@/components/content/LayoutLabeled.astro";
import StatList from "@/components/content/StatList.astro";
import PhotoPair from "@/components/content/PhotoPair.astro";
import ListRow from "@/components/content/ListRow.astro";
import heroImage from "@/assets/images/about/hero.avif";
import workshop1 from "@/assets/images/about/workshop-1.avif";
import workshop2 from "@/assets/images/about/workshop-2.avif";
import method1 from "@/assets/images/about/method-1.avif";
import method2 from "@/assets/images/about/method-2.avif";
import footerImage from "@/assets/images/footer/live-the-dream.avif";

const woods = (await getCollection("woods")).sort(
  (a, b) => a.data.order - b.data.order,
);

const stats = [
  { value: 12, label: "Years of experience" },
  { value: 160, suffix: "+", label: "Custom projects completed" },
  { value: 50, suffix: "+", label: "Returning clients" },
  { value: 10, label: "Week turnaround" },
];

const approach = [
  {
    title: "Bespoke solutions for every space",
    text: "No two homes—and no two clients—are the same. Every piece we create is designed around your space, your style, and the way you actually live.",
  },
  {
    title: "Completely in-house team, no middlemen",
    text: "From first sketch to final polish, everything happens under our roof. That means total control over quality, timelines, and the little details that matter most.",
  },
  {
    title: "100% transparent pricing",
    text: "No surprises, no fine print. We’ll walk you through every cost up front so you know exactly what you’re getting and why.",
  },
  {
    title: "Personal communication and updates at every step",
    text: "You’ll never wonder where your project stands. We check in, share progress, and keep you involved—because it’s your vision we’re building.",
  },
  {
    title: "Commitment to quality and lasting craftsmanship",
    text: "We build with care, precision, and materials that stand the test of time—pieces you’ll be proud of today and decades from now.",
  },
];
---

<BaseLayout
  title="About"
  description="At Woodream your vision is crafted in-house by the same hands that first heard your idea. With us there is no outsourcing, no detail lost along the way and no dream too big."
  footerBanner={{ image: footerImage, text: "live the dream." }}
>
  {/* Hero */}
  <Section paddingTop="navoverlap" paddingBottom="none">
    <HeroMain line1="If you can" line2="dream it.">
      At Woodream your vision is crafted in-house by the same hands that first
      heard your idea. With us there is no outsourcing, no detail lost along the
      way and no dream too big.
    </HeroMain>
  </Section>

  <BannerPhoto variant="hero" image={heroImage}>
    In-house.
    <br />
    For you.
  </BannerPhoto>

  {/* Stats */}
  <Section>
    <StatList stats={stats} />
  </Section>

  {/* About us */}
  <Section>
    <LayoutLabeled label="About us" headingMaxWidth={14} gap="tight">
      <Fragment slot="heading">Built around you</Fragment>
      <Fragment slot="intro">
        Some see lumber, but our dream team sees limitless possibility. Every
        project begins in our workshop, where precision, focus, and true care
        shape each detail. This is where the magic happens.
      </Fragment>
      <PhotoPair
        first={workshop1}
        firstAlt="Woodream craftsmen at work in the workshop"
        second={workshop2}
        secondAlt="Detail of custom woodwork"
      >
        Woodwork is what we do. Making it yours is why we do it. Everything you
        see here was crafted start to finish in our workshop by a team that
        knows every inch of your plan and project.
      </PhotoPair>
    </LayoutLabeled>
  </Section>

  {/* Design methodology */}
  <Section>
    <LayoutLabeled label="Design Methodology" headingMaxWidth={14}>
      <Fragment slot="heading">Etched in time.</Fragment>
      <Fragment slot="intro">
        At Woodream, we craft spaces that blend purpose with beauty. Every
        detail is carefully considered and contributes to the whole. Ideas
        evolve into carefully chosen materials—oak for durability, walnut for
        rich color, and maple for a smooth finish—and from there your vision
        comes to life.
        <br />
        <br />
        Our premium-grade stains and finishes protect and enhance the natural
        beauty of the wood, and expert craftsmanship ensures a flawless finish.
        The result is something you’ll love and live with for a lifetime.
      </Fragment>
      <PhotoPair
        variant="split"
        first={method1}
        firstAlt="Custom millwork in a finished room"
        second={method2}
        secondAlt="Wood finish detail"
      />
      <Button element="link" variant="link" href="/gallery">
        View Gallery
      </Button>
    </LayoutLabeled>
  </Section>

  {/* Wood selection */}
  <Section>
    <LayoutLabeled label="Wood Selection" headingMaxWidth={14}>
      <Fragment slot="heading">Crafted from the finest woods.</Fragment>
      <Fragment slot="intro">
        Our woods are selected not just for their look, but for how they live
        with you — durable, versatile, and timeless.
      </Fragment>
      <ul class="width-full">
        {woods.map(({ data }) => (
          <ListRow
            variant="wood"
            title={data.name}
            text={data.description}
            note={`Where you’ve seen it: ${data.seenIn}`}
            image={data.image}
            hoverImage={data.hoverImage}
          />
        ))}
      </ul>
    </LayoutLabeled>
  </Section>

  {/* Our approach */}
  <Section>
    <LayoutLabeled label="Our Approach" headingMaxWidth={14}>
      <Fragment slot="heading">Design with you in mind.</Fragment>
      <Fragment slot="intro">
        Our priority is to exceed your expectations. Not just in the final
        result but throughout the entire process.
      </Fragment>
      <ul class="width-full">
        {approach.map((item) => (
          <ListRow variant="approach" title={item.title} text={item.text} />
        ))}
      </ul>
    </LayoutLabeled>
  </Section>
</BaseLayout>
