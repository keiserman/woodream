---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Configurator from '../../components/Configurator.astro';
import { getProducts } from '../../lib/products';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
---

<Layout
  title={`${product.name} | Woodream`}
  description={`Build your ${product.name.toLowerCase()}. Start customizing and watch it update live.`}
>
  <Configurator product={product} />
</Layout>
