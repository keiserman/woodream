---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import ContactBlock from "@/components/content/ContactBlock.astro";
import contactImage from "@/assets/images/contact/ready.avif";
---

<BaseLayout
  title="Contact"
  description="Great work starts with a good conversation. Tell us what you’re dreaming — we’ll take it from there."
  footer="minimal"
>
  {/* Hero */}
  <Section paddingTop="navoverlap" paddingBottom="none">
    <HeroMain line1="Contact Us" size="compact">
      Great work starts with a good conversation.
      <br />
      Tell us what you’re dreaming — we’ll take it from there.
    </HeroMain>
  </Section>

  {/* Form */}
  <Section id="contact" paddingTop="small">
    <ContactBlock image={contactImage} />
  </Section>
</BaseLayout>
