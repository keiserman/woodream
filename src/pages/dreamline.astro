---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Slider from "@/components/interactive/Slider.astro";
import Button from "@/components/Button.astro";
import HeroSplit from "@/components/content/HeroSplit.astro";
import LayoutLabeled from "@/components/content/LayoutLabeled.astro";
import CardProduct from "@/components/content/CardProduct.astro";
import CardStep from "@/components/content/CardStep.astro";
import heroImage from "@/assets/images/dreamline/hero.jpg";
import footerImage from "@/assets/images/footer/ready.avif";
import diningRoomTable from "@/assets/images/dreamline/dining-room-table.png";
import studyTable from "@/assets/images/dreamline/study-table.png";
import threePieceBookshelf from "@/assets/images/dreamline/3-piece-bookshelf.png";
import fourPieceBookshelf from "@/assets/images/dreamline/4-piece-bookshelf.png";
import fivePieceBookshelf from "@/assets/images/dreamline/5-piece-bookshelf.png";

const products = [
  {
    name: "Dining Room Tables",
    href: "/cabinets/dining-room-table",
    image: diningRoomTable,
  },
  { name: "Study Table", href: "/cabinets/study-table", image: studyTable },
  {
    name: "3-piece Bookshelf",
    href: "/cabinets/3-piece-bookshelf",
    image: threePieceBookshelf,
  },
  {
    name: "4-piece Bookshelf",
    href: "/cabinets/4-piece-bookshelf",
    image: fourPieceBookshelf,
  },
  {
    name: "5-piece Bookshelf",
    href: "/cabinets/5-piece-bookshelf",
    image: fivePieceBookshelf,
  },
];

const steps = [
  {
    title: "Premium Quality",
    text: "All pieces are solid wood, not pressed materials, built to the trusted WoodDream standard for lasting craftsmanship.",
  },
  {
    title: "Endless Customization",
    text: "A wide range of finishes, colors, and styles to suit every taste and budget, including doors, legs, trims, and more.",
  },
  {
    title: "Instant Pricing",
    text: "Cost updates live as the options are selected, providing complete transparency without waiting for quotes.",
  },
  {
    title: "Accessible Luxury",
    text: "Options are ready to mix and match, cutting out extra labor and middlemen for surprisingly affordable pricing.",
  },
];
---

<BaseLayout
  title="Dreamline"
  description="Introducing Dreamline by WoodDream: design your custom solid wood furniture with our live form and see real-time pricing."
  footerBanner={{ image: footerImage, text: "design the dream." }}
>
  {/* Hero */}
  <Section paddingTop="navoverlap">
    <HeroSplit
      heading="From dream to done."
      image={heroImage}
      imageAlt="A custom solid wood library with floor-to-ceiling bookshelves"
    >
      Introducing Dreamline by WoodDream, a revolutionary concept in custom
      solid wood furniture. No more inflated quotes or drawn-out
      back-and-forths. With our live form you can design your piece and see
      real-time pricing for an effortless, elevated, and attainable experience.
      <Button slot="action" element="link" variant="link" href="/contact">
        Customize Your Own
      </Button>
    </HeroSplit>
  </Section>

  {/* Products */}
  <Section id="customize">
    <LayoutLabeled label="Dreamline" gap="medium" flush>
      <Fragment slot="heading">
        Customize
        <br />
        your piece
      </Fragment>
      <Fragment slot="intro">
        Choose your materials, style, and finishes with live pricing as you
        build. Submit your design and we’ll make it a reality.
      </Fragment>
      <Slider label="Products to customize" variant="contained" large={3}>
        {products.map((product) => (
          <CardProduct
            name={product.name}
            href={product.href}
            image={product.image}
          />
        ))}
      </Slider>
    </LayoutLabeled>
  </Section>

  {/* Steps */}
  <Section>
    <LayoutLabeled label="Steps" gap="medium" flush>
      <Fragment slot="heading">Dreamline is custom streamlined.</Fragment>
      <Fragment slot="intro">
        From design to delivery, every detail of your custom piece is
        effortless.
      </Fragment>
      <Slider
        label="What makes Dreamline different"
        variant="contained"
        large={2}
      >
        {steps.map((step, i) => (
          <CardStep number={i + 1} title={step.title} text={step.text} />
        ))}
      </Slider>
      <Button element="link" variant="link" href="#customize">
        Show me the way
      </Button>
    </LayoutLabeled>
  </Section>
</BaseLayout>
