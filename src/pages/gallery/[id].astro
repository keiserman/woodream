---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import GalleryNav from "@/components/content/GalleryNav.astro";
import GalleryPhotos from "@/components/content/GalleryPhotos.astro";
import { GALLERY_INTRO } from "@/consts.ts";
import { withAlt } from "@/lib/gallery.ts";

export async function getStaticPaths() {
  const categories = (await getCollection("gallery")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return categories.map((entry) => ({
    params: { id: entry.id },
    props: { entry, categories },
  }));
}

interface Props {
  entry: CollectionEntry<"gallery">;
  categories: CollectionEntry<"gallery">[];
}

const { entry, categories } = Astro.props;
const { name } = entry.data;
const photos = await withAlt(entry.data.photos, name);
const links = categories.map((category) => ({
  href: `/gallery/${category.id}`,
  label: category.data.name,
}));
---

<BaseLayout
  title={name}
  description={`Custom ${name.toLowerCase()} by Woodream, designed, built and finished in-house. Browse the photos and start your own.`}
>
  {/* Hero and photos */}
  <Section paddingTop="navoverlap" gap="5">
    <HeroMain line1={name} size="compact">
      {GALLERY_INTRO}
    </HeroMain>
    <div class="width-full">
      <GalleryNav links={links} current={`/gallery/${entry.id}`} />
      <GalleryPhotos photos={photos} />
    </div>
  </Section>
</BaseLayout>
