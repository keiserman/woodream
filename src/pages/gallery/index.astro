---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import GalleryStagger from "@/components/content/GalleryStagger.astro";
import { GALLERY_INTRO } from "@/consts.ts";

const categories = (await getCollection("gallery"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    name: entry.data.name,
    href: `/gallery/${entry.id}`,
    cover: entry.data.cover,
  }));
---

<BaseLayout title="Gallery" description={GALLERY_INTRO}>
  {/* Hero and categories */}
  <Section paddingTop="navoverlap" gap="5">
    <HeroMain line1="our gallery" size="compact">
      {GALLERY_INTRO}
    </HeroMain>
    <GalleryStagger categories={categories} />
  </Section>
</BaseLayout>
