---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Slider from "@/components/interactive/Slider.astro";
import Card from "@/components/item/Card.astro";
import Button from "@/components/Button.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import BannerPhoto from "@/components/content/BannerPhoto.astro";
import LayoutLabeled from "@/components/content/LayoutLabeled.astro";
import AboutIntro from "@/components/content/AboutIntro.astro";
import CardGallery from "@/components/content/CardGallery.astro";
import ListRow from "@/components/content/ListRow.astro";
import heroImage from "@/assets/images/home/hero.avif";
import aboutImage from "@/assets/images/home/about-1.avif";
import aboutBackground from "@/assets/images/home/about-2.avif";
import howWeWork1 from "@/assets/images/home/how-we-work-1.avif";
import howWeWork2 from "@/assets/images/home/how-we-work-2.avif";
import howWeWork3 from "@/assets/images/home/how-we-work-3.avif";

const byOrder = (
  a: { data: { order: number } },
  b: { data: { order: number } },
) => a.data.order - b.data.order;
const galleries = (await getCollection("gallery")).sort(
  (a, b) => a.data.homeOrder - b.data.homeOrder,
);
const steps = (await getCollection("processSteps")).sort(byOrder);
const testimonials = (await getCollection("testimonials")).sort(byOrder);

const perks = [
  { title: "Accessible Pricing", note: "No middleman markup." },
  { title: "Limitless design options", note: "No dream too big." },
  { title: "Uncompromising quality", note: "Built to last." },
];

const standards = [
  {
    title: "On call",
    text: "You’ll always reach someone who knows your project and is ready to help.",
    image: howWeWork1,
  },
  {
    title: "On point",
    text: "Your vision matters. We make sure the final result reflects it exactly.",
    image: howWeWork2,
  },
  {
    title: "On record",
    text: "You can count on us for accessible pricing and transparent turnaround times.",
    image: howWeWork3,
  },
];
---

<BaseLayout title="Custom Millwork Made for You">
  {/* Hero */}
  <Section paddingTop="navoverlap" paddingBottom="none">
    <HeroMain line1="the custom" line2="experience.">
      At Woodream, custom goes beyond the outcome. It’s how we begin, build, and
      finish.
    </HeroMain>
  </Section>

  <BannerPhoto variant="hero" image={heroImage}>
    Millwork <br />
    made for you.
  </BannerPhoto>

  {/* About */}
  <Section>
    <LayoutLabeled label="About us" headingMaxWidth={14}>
      <Fragment slot="heading">Built by hand, backed by heart</Fragment>
      <Fragment slot="intro">
        We deliver luxury and elevated design, with a personal touch that makes
        you feel at home.
      </Fragment>
      <AboutIntro
        photo={aboutImage}
        photoAlt="Custom millwork detail"
        image={aboutBackground}
        imageAlt="Woodream custom interior"
        perks={perks}
      />
    </LayoutLabeled>
  </Section>

  {/* Gallery */}
  <Section theme="brand">
    <LayoutLabeled label="Gallery" headingMaxWidth={16}>
      <Fragment slot="heading">Woodream makes the dream work.</Fragment>
      <Fragment slot="intro">
        Take your vision further with custom millwork.
      </Fragment>
      <Slider
        label="Gallery categories"
        variant="crop-start"
        small={2}
        large={2.5}
      >
        {galleries.map((entry, i) => (
          <CardGallery
            name={entry.data.name}
            href={`/gallery/${entry.id}`}
            image={entry.data.cover}
            delay={i * 0.1}
          />
        ))}
      </Slider>
      <Button element="link" variant="link" href="/gallery">
        View Gallery
      </Button>
    </LayoutLabeled>
  </Section>

  {/* Process */}
  <Section>
    <LayoutLabeled label="Our Process">
      <Fragment slot="heading">Built around you.</Fragment>
      <Fragment slot="intro">
        We’re in the business of making your dreams come true.
      </Fragment>
      <ol class="width-full">
        {steps.map((step, i) => (
          <ListRow
            number={i + 1}
            title={step.data.title}
            text={step.data.text}
          />
        ))}
      </ol>
      <Button element="link" variant="link" href="/contact">
        Get started
      </Button>
    </LayoutLabeled>
  </Section>

  {/* Testimonials */}
  <Section theme="brand" paddingBottom="large">
    <LayoutLabeled label="What our clients say about us">
      <Fragment slot="heading">
        Nailed. <br />
        Every time.
      </Fragment>
      <Fragment slot="intro">
        Hear firsthand how precision, passion, and seamless service set Woodream
        apart.
      </Fragment>
      <Slider
        label="Client testimonials"
        variant="crop-start"
        small={2}
        large={2.5}
      >
        {testimonials.map((entry) => (
          <Card class="text-style-small" text={entry.data.quote} />
        ))}
      </Slider>
    </LayoutLabeled>
  </Section>

  {/* How we work */}
  <Section>
    <LayoutLabeled label="How we work" headingMaxWidth={14}>
      <Fragment slot="heading">
        Craftsmanship <br />+ Care
      </Fragment>
      <Fragment slot="intro">The Woodream standard.</Fragment>
      <ul class="width-full">
        {standards.map((item) => (
          <ListRow
            variant="feature"
            title={item.title}
            text={item.text}
            image={item.image}
            buttonLabel="Learn more"
            buttonHref="/contact"
          />
        ))}
      </ul>
    </LayoutLabeled>
  </Section>
</BaseLayout>
