---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ListRow from '../components/ListRow.astro';
import Button from '../components/Button.astro';
import ImageBanner from '../components/ImageBanner.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';
import Slider from '../components/Slider.astro';
import { backgroundUrl } from '../lib/images';
import heroImage from '../assets/images/home/hero.avif';
import aboutImage from '../assets/images/home/about-1.avif';
import aboutBackground from '../assets/images/home/about-2.avif';
import howWeWork1 from '../assets/images/home/how-we-work-1.avif';
import howWeWork2 from '../assets/images/home/how-we-work-2.avif';
import howWeWork3 from '../assets/images/home/how-we-work-3.avif';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const galleries = await Promise.all(
  (await getCollection('gallery'))
    .sort((a, b) => a.data.homeOrder - b.data.homeOrder)
    .map(async (entry) => ({
      ...entry.data,
      href: `/gallery/${entry.id}`,
      cover: await backgroundUrl(entry.data.cover, 900),
    })),
);
const steps = (await getCollection('processSteps')).sort(byOrder).map((entry) => entry.data);
const testimonials = (await getCollection('testimonials')).sort(byOrder).map((entry) => entry.data.quote);
const aboutBackgroundUrl = await backgroundUrl(aboutBackground, 1400);

const perks = [
  { title: 'Accessible Pricing', note: 'No middleman markup.' },
  { title: 'Limitless design options', note: 'No dream too big.' },
  { title: 'Uncompromising quality', note: 'Built to last.' },
];

const standards = [
  {
    title: 'On call',
    text: 'You’ll always reach someone who knows your project and is ready to help.',
    image: howWeWork1,
  },
  {
    title: 'On point',
    text: 'Your vision matters. We make sure the final result reflects it exactly.',
    image: howWeWork2,
  },
  {
    title: 'On record',
    text: 'You can count on us for accessible pricing and transparent turnaround times.',
    image: howWeWork3,
  },
];
---

<Layout>
  <PageHero line1="the custom" line2="experience.">
    At Woodream, custom goes beyond the outcome. It’s how we begin, build, and finish.
  </PageHero>

  <ImageBanner image={heroImage}>Millwork <br />made for you.</ImageBanner>

  <!-- About -->
  <Section
    tab="About us"
    headingClass="max-w-[338px] max-md:max-w-none"
  >
    <Fragment slot="heading">Built by hand, backed by heart</Fragment>
    <Fragment slot="intro">We deliver luxury and elevated design, with a personal touch that makes you feel at home.</Fragment>
    <div class="flex w-full items-stretch justify-between gap-5 max-sm:flex-col">
      <div class="flex w-2/5 flex-col gap-[50px] max-sm:w-full">
        <div class="relative overflow-hidden pb-2.5">
          <Image
            src={aboutImage}
            alt="Custom millwork detail"
            widths={[240, 480, 800]}
            sizes="(max-width: 479px) 100vw, 240px"
            format="avif"
            class="w-[240px] max-sm:w-full"
          />
        </div>
        <div class="relative flex flex-col gap-[30px] overflow-hidden pb-2.5">
          {
            perks.map((perk) => (
              <div>
                <div>{perk.title}</div>
                <div class="text-[21px]">{perk.note}</div>
              </div>
            ))
          }
        </div>
      </div>
      <div
        role="img"
        aria-label="Woodream custom interior"
        class="relative w-3/5 bg-cover bg-center max-sm:min-h-[300px] max-sm:w-full"
        style={`background-image:url(${aboutBackgroundUrl})`}
      >
      </div>
    </div>
  </Section>

  <!-- Gallery -->
  <Section
    beige
    tab="Gallery"
    headingClass="max-w-[393px]"
  >
    <Fragment slot="heading">Woodream makes the dream work.</Fragment>
    <Fragment slot="intro">Take your vision further with custom millwork.</Fragment>
    <Slider count={galleries.length} label="Gallery categories" class="-mb-[50px] flex-col max-lg:mb-0">
      {
        galleries.map((item, i) => (
          <div class="w-full shrink-0">
            <div class="mr-5">
              <Reveal dir="left" delay={i * 0.1} class="flex w-full flex-col items-end">
                <p class="mb-2.5">{item.name}</p>
                <a
                  href={item.href}
                  data-cursor-area
                  aria-label={`Explore ${item.name}`}
                  class="relative block h-[500px] w-full bg-cover bg-center"
                  style={`background-image:url(${item.cover})`}
                >
                  <div class="fake-cursor size-[125px] min-h-[125px] min-w-[125px]" aria-hidden="true">
                    <span class="fake-cursor-label">Explore more</span>
                  </div>
                </a>
              </Reveal>
            </div>
          </div>
        ))
      }
    </Slider>
    <Button href="/gallery">View Gallery</Button>
  </Section>

  <!-- Process -->
  <Section
    tab="Our Process"
  >
    <Fragment slot="heading">Built around you.</Fragment>
    <Fragment slot="intro">We’re in the business of making your dreams come true.</Fragment>
    <ol class="w-full">
      {
        steps.map((step, i) => (
          <ListRow as="li" variant="step">
            <div class="flex w-[43%] items-center justify-start gap-40 xl:gap-[180px] max-lg:w-auto max-lg:gap-[100px] max-sm:gap-5">
              <div class="min-w-[9%] max-sm:min-w-0">{String(i + 1).padStart(2, '0')}</div>
              <div>{step.title}</div>
            </div>
            <div class="w-[45%] max-lg:w-full">{step.text}</div>
          </ListRow>
        ))
      }
    </ol>
    <Button href="/contact">Get started</Button>
  </Section>

  <!-- Testimonials -->
  <Section
    beige
    tab="What our clients say about us"
    class="pb-[220px] max-lg:pb-[195px] max-md:pb-[150px]"
  >
    <Fragment slot="heading">Nailed. <br />Every time.</Fragment>
    <Fragment slot="intro">Hear firsthand how precision, passion, and seamless service set Woodream apart.</Fragment>
    <Slider count={testimonials.length} label="Client testimonials" floatingBar class="pb-10">
      {
        testimonials.map((quote) => (
          <div class="w-full shrink-0">
            <blockquote class="mr-5 h-full rounded-[20px] bg-bg p-10 text-[20px] leading-[1.3] max-md:p-[30px]">
              {quote}
            </blockquote>
          </div>
        ))
      }
    </Slider>
  </Section>

  <!-- How we work -->
  <Section
    tab="How we work"
    headingClass="max-w-[338px] max-md:max-w-none"
  >
    <Fragment slot="heading">Craftsmanship <br />+ Care</Fragment>
    <Fragment slot="intro">The Woodream standard.</Fragment>
    <div class="w-full">
      {
        standards.map((item) => (
          <ListRow variant="feature">
            <div class="flex w-1/2 flex-col items-start justify-start gap-[30px] max-sm:w-full">
              <div class="text-[30px]">{item.title}</div>
              <div>{item.text}</div>
              <Button href="/contact" class="pt-10">Learn more</Button>
            </div>
            <Image
              src={item.image}
              alt=""
              widths={[362, 724]}
              sizes="(max-width: 479px) 100vw, 362px"
              format="avif"
              class="w-1/2 max-w-[362px] max-sm:w-full"
            />
          </ListRow>
        ))
      }
    </div>
  </Section>
</Layout>
